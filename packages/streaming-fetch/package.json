{
  "name": "@the-polyfills/streaming-fetch",
  "version": "2.1.0",
  "description": "Streaming fetch over XMLHttpRequest, with a Server-Sent Events reader. Built for React Native, works in browsers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "del-cli dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "pnpm build",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && prettier --check . && eslint ."
  },
  "keywords": [
    "react-native",
    "fetch",
    "streaming",
    "xhr",
    "xmlhttprequest",
    "sse",
    "server-sent-events",
    "event-stream"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doanhtu07/react-native-the-polyfills.git"
  },
  "author": "Anh Tu Do <doanhtu07@gmail.com> (https://github.com/doanhtu07)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/doanhtu07/react-native-the-polyfills/issues"
  },
  "homepage": "https://github.com/doanhtu07/react-native-the-polyfills#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "del-cli": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
